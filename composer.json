{
    "name": "xavierleune/ting",
    "description": "Ting : a lightweight datamapper",
    "homepage": "http://tech.ccmbg.com/ting/",
    "keywords": [
        "datamapper",
        "database",
        "mapper",
        "model",
        "entity",
        "unitofwork",
        "repository",
        "mysql",
        "pgsql"
    ],
    "support": {
        "issues": "https://github.com/xavierleune/ting/issues",
        "source": "https://github.com/xavierleune/ting",
        "docs": "http://tech.ccmbg.com/ting/doc/en/"
    },
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2",
        "aura/sqlquery": "^2.6 || ^3.0",
        "symfony/property-access": "^7.0 || ^8.0",
        "symfony/cache-contracts": "^3.0"
    },
    "replace": {
        "ccmbenchmark/ting": "self.version"
    },
    "require-dev": {
        "ext-pgsql": "*",
        "ext-mysqli": "*",
        "brick/geo": "^0.5.1",
	    "pimple/pimple": "^3.0",
        "symfony/uid": "^7.0 || ^8.0",
        "symfony/cache": "^7.0 || ^8.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.1",
        "tomasvotruba/type-coverage": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
      "brick/geo": "Allow support of MariaDB Geometry type",
      "pimple/pimple": "Service container.",
      "symfony/uid": "To work with Uuid.",
      "symfony/cache": "Cache pools (Redis, Memcached, APCu...) for cached queries."
    },
    "autoload": {
        "psr-4" : {
            "CCMBenchmark\\Ting\\": "src/Ting/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\fixtures\\": "tests/fixtures/",
            "CCMBenchmark\\Ting\\Tests\\": "tests/",
            "CCMBenchmark\\Ting\\PHPStan\\": "phpstan/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": [
            "@putenv XDEBUG_MODE=off",
            "phpunit"
        ]
    }
}
