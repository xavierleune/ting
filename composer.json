{
    "name": "xavierleune/ting",
    "description": "Ting : a lightweight datamapper",
    "homepage": "http://tech.ccmbg.com/ting/",
    "keywords": [
        "datamapper",
        "database",
        "mapper",
        "model",
        "entity",
        "unitofwork",
        "repository",
        "mysql",
        "pgsql"
    ],
    "support": {
        "issues": "https://github.com/xavierleune/ting/issues",
        "source": "https://github.com/xavierleune/ting",
        "docs": "http://tech.ccmbg.com/ting/doc/en/"
    },
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2",
        "aura/sqlquery": "^2.6 || ^3.0",
        "doctrine/cache": "^1.6",
        "symfony/property-access": "^7.0 || ^8.0"
    },
    "replace": {
        "ccmbenchmark/ting": "self.version"
    },
    "require-dev": {
        "ext-pgsql": "*",
        "ext-mysqli": "*",
        "atoum/atoum": "^4.0",
        "atoum/stubs": "^2.0",
        "brick/geo": "^0.5.1",
	    "pimple/pimple": "^3.0",
        "symfony/uid": "^7.0 || ^8.0",
        "symfony/cache": "^7.0 || ^8.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
      "brick/geo": "Allow support of MariaDB Geometry type",
      "pimple/pimple": "Service container.",
      "symfony/uid": "To work with Uuid."
    },
    "autoload": {
        "psr-4" : {
            "CCMBenchmark\\Ting\\": "src/Ting/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\fixtures\\": "tests/fixtures/",
            "CCMBenchmark\\Ting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
